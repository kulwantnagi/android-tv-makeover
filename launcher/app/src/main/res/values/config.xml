<?xml version="1.0" encoding="utf-8"?>
<!-- Edit this file to customise the home screen, then run ./build_and_install.sh -->
<resources>
    <!-- Dock apps, left to right. Package names; missing or disabled apps are skipped. -->
    <string-array name="dock_packages">
        <item>com.netflix.ninja</item>
        <item>com.amazon.amazonvideo.livingroom</item>
        <item>in.startv.hotstar</item>
        <item>com.google.android.youtube.tv</item>
        <item>com.nk.live_tv</item>
    </string-array>

    <!-- Apps per row in the grid (3 to 6). -->
    <integer name="columns">5</integer>

    <!-- Dock slots the dock cards are sized for (4 to 8). The tray hugs however many dock apps
         there are, centred; add packages above to fill it. -->
    <integer name="dock_columns">5</integer>

    <!-- "Last played" thumbnails above the dock for the focused app. false = never shown, and the
         launcher stops checking what's playing. -->
    <bool name="show_recently_watched">false</bool>

    <!-- Apps never shown in the grid. -->
    <string-array name="hidden_packages">
        <item>com.google.android.tvlauncher</item>
        <item>com.android.tv.settings</item>
        <item>com.mitv.dream</item>
        <item>com.android.gallery3d</item>
    </string-array>

    <!-- Your name for the greeting and your social accounts for the follower counters live in
         launcher/personal.properties (git-ignored, so they're never published): see the README. -->


    <!-- Wallpapers: 1280x720 images named wallpaper_1.jpg, wallpaper_2.jpg, ... in res/drawable-nodpi/.
         With more than one they fade from one to the next every wallpaper_seconds. false = pitch black. -->
    <bool name="use_wallpaper">true</bool>
    <integer name="wallpaper_seconds">30</integer>
</resources>
